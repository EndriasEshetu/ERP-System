# ==============================================================================
# ERP Platform - Local Development Environment Variables Template
# Copy this file to .env before starting the development environment.
# DO NOT commit real secrets or .env files to Git.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend API Configuration
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=erp_session
SESSION_TTL_HOURS=24
SESSION_SECRET=dev_session_secret_change_in_production

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_db
DB_USER=erp_admin
DB_PASSWORD=erp_secure_password_dev_only
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Frontend Configuration (Vite requires VITE_ prefix for client-accessible variables)
VITE_API_URL=http://localhost:5000/api/v1

