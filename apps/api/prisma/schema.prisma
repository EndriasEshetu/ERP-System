datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Minimal model for connection verification during milestone 1
model SystemCheck {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  checkedAt DateTime @default(now())

  @@map("system_checks")
}

// ==========================================
// 1 & 2. Units of Measurement & Products
// ==========================================

model UnitOfMeasurement {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String    // e.g., "Kilogram", "Piece", "Box"
  symbol         String    // e.g., "kg", "pcs", "box"
  category       String?   // e.g., "Weight", "Volume", "Unit"
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  products       Product[]

  @@unique([organizationId, symbol])
  @@index([organizationId])
  @@map("units_of_measurement")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  code           String?
  parentId       String?    @map("parent_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

enum ProductType {
  STORABLE     // Tracked in inventory
  CONSUMABLE   // Stock not tracked
  SERVICE      // Non-physical
}

model Product {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  sku            String
  barcode        String?
  name           String
  description    String?
  type           ProductType       @default(STORABLE)
  categoryId     String?           @map("category_id")
  uomId          String            @map("uom_id")
  costPrice      Decimal           @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  salePrice      Decimal           @default(0.00) @map("sale_price") @db.Decimal(12, 2)
  reorderPoint   Int               @default(10) @map("reorder_point")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  category       Category?         @relation(fields: [categoryId], references: [id])
  uom            UnitOfMeasurement @relation(fields: [uomId], references: [id])
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  poItems        PurchaseOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("products")
}

// ==========================================
// 3 & 4. Warehouses & Stock Inventory
// ==========================================

model Warehouse {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  code           String
  address        String?
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  stockLevels    StockLevel[]
  movementsFrom  StockMovement[] @relation("SourceWarehouse")
  movementsTo    StockMovement[] @relation("DestWarehouse")
  goodsReceipts  GoodsReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model StockLevel {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  warehouseId    String    @map("warehouse_id")
  quantityOnHand Decimal   @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  reservedQty    Decimal   @default(0) @map("reserved_qty") @db.Decimal(12, 3)
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product        Product   @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, productId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("stock_levels")
}

enum MovementType {
  RECEIPT       // Purchase receipt into warehouse
  DELIVERY      // Sales order fulfillment
  INTERNAL      // Warehouse to warehouse transfer
  ADJUSTMENT_IN // Inventory count surplus
  ADJUSTMENT_OUT// Scrap, damage, or loss
}

model StockMovement {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  productId         String       @map("product_id")
  sourceWarehouseId String?      @map("source_warehouse_id")
  destWarehouseId   String?      @map("dest_warehouse_id")
  quantity          Decimal      @db.Decimal(12, 3)
  type              MovementType
  referenceNumber   String?      @map("reference_number") // e.g., PO-1001, GRN-001
  notes             String?
  createdBy         String       @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  product           Product      @relation(fields: [productId], references: [id])
  sourceWarehouse   Warehouse?   @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?   @relation("DestWarehouse", fields: [destWarehouseId], references: [id])

  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("stock_movements")
}

// ==========================================
// 5, 6 & 7. Procurement & Goods Receiving
// ==========================================

model Supplier {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  taxId          String?         @map("tax_id")
  paymentTerms   String?         @map("payment_terms") // e.g. "Net 30"
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  orderNumber     String              @map("order_number")
  supplierId      String              @map("supplier_id")
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now()) @map("order_date")
  expectedDate    DateTime?           @map("expected_date")
  totalAmount     Decimal             @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  notes           String?
  createdBy       String              @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  productId       String        @map("product_id")
  orderedQty      Decimal       @map("ordered_qty") @db.Decimal(12, 3)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(12, 3)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal       @map("total_price") @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  receiptNumber   String             @map("receipt_number") // e.g. GRN-2026-0001
  purchaseOrderId String             @map("purchase_order_id")
  warehouseId     String             @map("warehouse_id")
  receivedDate    DateTime           @default(now()) @map("received_date")
  receivedBy      String             @map("received_by")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")

  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  items           GoodsReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(uuid())
  goodsReceiptId String       @map("goods_receipt_id")
  productId      String       @map("product_id")
  quantity       Decimal      @db.Decimal(12, 3)

  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

// ==========================================
// 8. Notifications
// ==========================================

enum NotificationType {
  LOW_STOCK
  PO_APPROVED
  GOODS_RECEIVED
  SYSTEM_ALERT
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String?          @map("user_id") // null = broadcast to org
  title          String
  message        String
  type           NotificationType
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([organizationId, userId, isRead])
  @@map("notifications")
}
