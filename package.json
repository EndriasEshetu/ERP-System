{
  "name": "erp-system",
  "version": "0.1.0",
  "private": true,
  "description": "Modular, commercial-grade ERP platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@erp/api",
    "dev:web": "npm run dev --workspace=@erp/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "keywords": [
    "erp",
    "modular-monolith",
    "multi-tenant",
    "commercial-erp"
  ],
  "author": "ERP Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

